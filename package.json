{
  "_comment": "Root workspace package for running the TabTwin server, web app, and extension builds.",
  "name": "tabtwin",
  "version": "1.0.0",
  "private": true,
  "description": "Real-time browser tab collaboration with ghost cursors, annotations, and an AI browser agent.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "server",
    "webapp",
    "extension"
  ],
  "scripts": {
    "server": "npm --workspace server run start",
    "dev:web": "npm --workspace webapp run dev",
    "dev:extension": "npm --workspace extension run dev",
    "build": "npm --workspaces run build",
    "lint": "npm --workspaces run lint",
    "test": "node --test tests/**/*.test.js",
    "prepare": "husky",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,css,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,css,json,md}\""
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,css,json,md}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6"
  },
  "overrides": {
    "esbuild": "^0.25.0"
  }
}
