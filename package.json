{
  "_comment": "Root workspace package for running the TabTwin server, web app, and extension builds.",
  "name": "tabtwin",
  "version": "1.0.0",
  "private": true,
  "description": "Real-time browser tab collaboration with ghost cursors, annotations, and an AI browser agent.",
  "author": "Avdhesh Kumar Dadhich <aavdhesh.dadhich@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itzzavdheshh/TabTwin.git"
  },
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "server",
    "webapp",
    "extension"
  ],
  "scripts": {
    "server": "npm --workspace server run start",
    "dev:web": "npm --workspace webapp run dev",
    "dev:extension": "npm --workspace extension run dev",
    "build": "npm --workspaces run build",
    "lint": "npm --workspaces run lint",
    "test": "node --test tests/**/*.test.js",
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "fdir": "^6.5.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.0",
    "prettier": "^3.4.2"
  },
  "overrides": {
    "esbuild": "^0.25.0"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,json,css,md}": [
      "prettier --write"
    ]
  }
}
